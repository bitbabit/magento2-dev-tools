<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/devtools/ssr-logs/:ssrId" method="GET">
        <service class="BitBabit\DeveloperTools\Api\SsrLogRepositoryInterface" method="getBySsrId"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/devtools/ssr-logs/:ssrId" method="DELETE">
        <service class="BitBabit\DeveloperTools\Api\SsrLogRepositoryInterface" method="clearBySsrId"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>

